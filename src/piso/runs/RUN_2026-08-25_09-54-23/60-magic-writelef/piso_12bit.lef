      LAYER Metal2 ;
        RECT 41.440 74.440 42.000 75.000 ;
    END
  END data_in[9]
  PIN load_en
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 0.396000 ;
    PORT
      LAYER Metal3 ;
        RECT 0.000 43.680 0.560 44.240 ;
    END
  END load_en
  PIN rst_n
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 0.396000 ;
    PORT
      LAYER Metal3 ;
        RECT 74.440 28.000 75.000 28.560 ;
    END
  END rst_n
  PIN serial_out
