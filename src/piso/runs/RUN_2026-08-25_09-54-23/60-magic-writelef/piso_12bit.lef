      LAYER Metal3 ;
        RECT 0.000 45.920 0.560 46.480 ;
    END
  END data_in[8]
  PIN data_in[9]
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 0.396000 ;
